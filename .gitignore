# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diretórios de build em qualquer lugar do projeto
**/dist/
**/build/
**/out/
**/.next/
**/.vercel/
**/.turbo/
**/.expo/
**/.cache/
**/tmp/
**/temp/
**/coverage/

# TypeScript
**/*.tsbuildinfo

# Logs
logs/
*.log
**/*.log

# dotenv
.env
.env.*
!.env.example

# IDEs e editores
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# SOs
.DS_Store
Thumbs.db

# Docker
**/.docker/
.dockerignore

# Testes
**/test-output/
**/.nyc_output/

# Gerados por bundlers
**/*.bundle.*
**/*.min.*

# Relatórios
*.lcov
*.clover

# Arquivos de lock antigos
package-lock.bak.json
yarn.lock.bak

# Arquivos exportados / gerados
**/*.export.*
**/*.generated.*

# Outras pastas comuns de saída
**/release/
**/bin/
**/obj/

# Git hooks locais
.husky/

# Custom: para apagar pastas já comitadas mesmo se estiverem dentro de outros diretórios
!src/**/dist/
!src/**/build/
