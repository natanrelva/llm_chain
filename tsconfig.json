{
  "compilerOptions": {
    "target": "ES2021",
    "module": "esnext",
    "lib": [
      "ES2021"
    ],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "*": [
        "node_modules/*"
      ],
      "backend": [
        "apps/backend/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.test.ts"
  ],
}