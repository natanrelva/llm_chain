    "prettier": "^3.6.2",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.2",
    "turbo": "^2.5.5"
  },
  "dependencies": {
    "chrono-node": "^2.8.3",
    "luxon": "^3.7.1"
  }
