{
  "name": "llm_chain",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/backend",
    "apps/provider"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:provider": "turbo run dev --filter=provider",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint 'apps/**/*.{js,cjs,ts,tsx}' --fix",
    "format": "prettier --write 'apps/**/*.{js,cjs,ts,tsx,json,yml,yaml}'",
    "typecheck": "tsc --noEmit -b apps/backend apps/provider"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.1",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^6.6.0",
    "jest": "^29.6.1",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "turbo": "^2.1.3",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "chrono-node": "^2.8.3",
    "luxon": "^3.7.1"
  }
}
