{
  "name": "llm_chain",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/backend",
    "apps/provider"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "turbo run dev --filter=backend",
