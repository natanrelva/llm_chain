{
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": true,
  "endOfLine": "lf",
  "singleAttributePerLine": true,
  "printWidth": 100,
  "useTabs": false,
  "overrides": [
    {
      "files": ["*.json", "package.json"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
